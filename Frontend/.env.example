# Production Backend API URL (leave blank for local dev proxy to http://127.0.0.1:5000)
VITE_API_URL=https://pixxtech-expense-tracker.vercel.app
# Optional allowlist for Messages & Calls. When either email is set, both configured
# email/role pairs are required to be eligible; otherwise the frontend uses its
# existing name-and-role fallback. The backend remains the authorization authority.
VITE_COMMUNICATION_ADMIN_EMAIL=
VITE_COMMUNICATION_DATA_ENTRY_EMAIL=

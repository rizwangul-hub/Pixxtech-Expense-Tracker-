PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/your_database
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated exact frontend origins. Production and the active Vercel preview are trusted.
CORS_ORIGIN=https://pixxtech-expense-tracker.vercel.app,https://pixxtech-expense-tracker-fz2h.vercel.app,http://localhost:5173

# Cloudinary credentials: configure real values in local environment / Vercel settings only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Communications are restricted to these existing active accounts and exact roles.
COMMUNICATION_ADMIN_EMAIL=admin@example.com
COMMUNICATION_DATA_ENTRY_EMAIL=data-entry@example.com

# Ably server-side key (never send this value to a browser or commit it).
ABLY_API_KEY=your_ably_api_key

# Optional production TURN service. Set all three values together.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=temporary-turn-username
# TURN_CREDENTIAL=temporary-turn-credential
